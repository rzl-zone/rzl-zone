{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": false,
    "lib": ["dom", "dom.iterable", "esnext"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["types", "*.config.ts", "./src/**/*"],
  "exclude": ["_deprecated", "node_modules"]
}
